# Optional. Compose runs without a .env file; copy this to .env only to change a setting.
#
# Order service: seconds each order waits before the simulated restaurant moves it one step.
# 0 = off (move orders by hand with scripts/restaurant.sh). If unset, compose.yaml uses 0 and compose.selfhost.yaml uses 30.
RESTAURANT_AUTO_ADVANCE_SECONDS=0
